{
  "$schema":"https://schema.tauri.app/config/2",
  "productName":"Gold Label Studio Pro",
  "version":"0.2.0",
  "identifier":"com.amirnourhan.goldlabelstudiopro",
  "build":{
    "beforeDevCommand":"npm run dev",
    "devUrl":"http://localhost:1420",
    "beforeBuildCommand":"npm run build",
    "frontendDist":"../dist"
  },
  "app":{
    "windows":[{
      "label":"main",
      "title":"Gold Label Studio Pro",
      "width":1600,
      "height":900,
      "minWidth":1024,
      "minHeight":640,
      "resizable":true,
      "fullscreen":false,
      "decorations":false,
      "center":true
    }],
    "security":{"csp":null}
  },
  "bundle":{
    "active":true,
    "targets":["nsis"],
    "icon":["icons/icon.ico"],
    "publisher":"AmirNourhan",
    "copyright":"© 2026 AmirNourhan",
    "category":"Business",
    "shortDescription":"سیستم جامع لیبل‌زنی و ردیابی طلا و جواهر",
    "longDescription":"Gold Label Studio Pro — ثبت محصولات، طراحی و چاپ لیبل QR، بسته‌بندی، مرجوعی، مدیریت دستگاه‌ها و پشتیبان‌گیری محلی.",
    "homepage":"https://github.com/amirnourhan-max/Gold-Label-Studio-Pro",
    "windows":{
      "webviewInstallMode":{"type":"downloadBootstrapper","silent":true}
    }
  }
}
